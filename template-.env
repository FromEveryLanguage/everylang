# Generated by scripts/generate-env-template.ts; do not edit this file directly.
# Run "npm run env:generate" after changing envConfig.ts.

# Core services
# Y-Sweet document service connection string.
YSWEET_CONNECTION_STRING=ys://...
# Google Gemini API key used for translation.
GEMINI_API_KEY=
# ElevenLabs API key used for text-to-speech.
ELEVENLABS_API_KEY=
# Maximum concurrent text-to-speech requests.
# TTS_MAX_CONCURRENT=2

# Write authorization and request limits
# Comma-separated labels and shared keys for privileged devices.
# WRITE_KEYS=
# Write authorization mode: off, observe, or enforce.
# WRITE_AUTH_MODE=observe
# Maximum text-to-speech requests per caller per minute; 0 disables the limit.
# TTS_RATE_LIMIT_PER_MIN=600
# Maximum live translation requests per caller per minute; 0 disables the limit.
# TRANSLATE_RATE_LIMIT_PER_MIN=1200

# Telemetry and source maps
# PostHog project key. Unset values disable telemetry.
# VITE_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host.
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Build-time PostHog CLI token used for source-map upload.
# POSTHOG_CLI_TOKEN=
# Build-time PostHog environment ID.
# POSTHOG_CLI_ENV_ID=
# Build-time PostHog CLI host.
# POSTHOG_CLI_HOST=https://us.i.posthog.com

# Live speech translation
# LiveKit server URL. All LiveKit credentials are needed to enable live audio.
# LIVEKIT_URL=
# LiveKit API key.
# LIVEKIT_API_KEY=
# LiveKit API secret.
# LIVEKIT_API_SECRET=
# Fallback spoken language for clients that do not declare one.
# LIVE_AUDIO_SOURCE_LANGUAGE=en
# Negative dBFS threshold for suspending idle translator sessions; unset disables silence gating.
# LIVE_AUDIO_SILENCE_THRESHOLD_DBFS=

# Slide translation
# Gemini model used for whole-item slide drafting.
# GEMINI_STRONG_MODEL=gemini-3.7-flash
# General context added to slide translation prompts.
# SLIDE_TRANSLATION_CONTEXT=These slides are shown at a Presbyterian Church in America (PCA) worship service. The translations are provided alongside the service so non-English speakers can follow along — they are for understanding and reference, not for congregational singing or as an official literal/liturgical rendering. When writing new translations, aim for clear and natural wording. However, that does NOT apply to Scripture texts; they should be looked up using the tool and the wording used without revision, even if it seems dated or awkward.
# Comma-separated display names of languages translated ahead by the slide feed.
# SLIDE_TRANSLATION_LANGUAGES=

# Current session
# IANA timezone used for current-session dates and pin expiry.
# SESSION_TIMEZONE=

# Persistent storage
# Path to the reviewed slide translation library.
# SLIDE_LIBRARY_PATH=audio-cache/slide-library.json
# Path to the current-session pin and proposal registry.
# SESSION_REGISTRY_PATH=audio-cache/current-session.json

# Landing page
# Optional landing-page heading.
# SITE_NAME=
# Comma-separated BCP-47 codes offered as landing-page language cards.
# SITE_LANGUAGES=

# Testing
# Set to 1 to allow LiveKit fault-injection routes outside development.
# ALLOW_CHAOS_ENDPOINT=

# Deployment
# Express server listening port.
# PORT=8000
# Node runtime environment.
# NODE_ENV=development
# Y-Sweet server authentication secret used by Docker Compose.
# Y_SWEET_AUTH=
# Y-Sweet server token used to connect the application.
# Y_SWEET_SERVER_TOKEN=
# Build-time source revision exposed in deployment logs.
# GIT_SHA=
